GROQ_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
GROQ_BASE_URL = https://api.groq.com

SYSTEM_CONTENT="You are a helpful and direct technical assistant. You will NOT respond to questions that are off-topic—that is, anything unrelated to spreadsheets!"

MESSAGE_TO_AI_GENERATE_BETTER_CODE = "If a tool is used or code is generated, provide ONLY the code. The code must be written exclusively in Python; if Python is insufficient (even with the necessary imports), inform the user that the system cannot fulfill their request. The code must be contained within the `main()` method of a class named `Groq_script_main`. Do not include comments or any additional text—provide ONLY the code. Imports must be placed at the beginning of the script, above the class definition. For the file path, use `from dotenv import load_dotenv` and call this method—with the parameter `override=True`—before any other code (following the imports). Also, use `from os import getenv` and assign the file path by calling `getenv('WORKING_SHEET_PATH')`. If the generated code is wrapped in markdown code blocks (e.g., ````python ````), please remove them; I require ONLY the code itself."

WORKING_SPREADSHEET_NAME = employees.xlsx